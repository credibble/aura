# Aura app configuration — copy to .env and fill in.
# Contract addresses come from smart-contracts/deployments/deployments.json.
VITE_MARKET_MAKER_ADDRESS=0x6b3d9D88Ec43b04F42e2F872073036c9ce6A4Dee
VITE_ORDER_BOOK_ADDRESS=0x0205f9fFC20d51CdB36c22E0D6dC901E6B9165e7
VITE_HANDLE_FACTORY_ADDRESS=0x5A4F966dCc5F858039E0cFD773056f184376496c
VITE_POOL_ADDRESS=0x6c6f0F5cBb510f78E2cd96f48D4166201F73dC6F
VITE_AURA_TOKEN_ADDRESS=0xD21F6B560A2583628688FA8167dE0E7474E22c7A
VITE_USDC_ADDRESS=0x49ddC76A09b045cE49ffD3aa62F178A494705d68
VITE_REVENUE_SHARING_ADDRESS=0x808b3c64F496c365B173739F8c124de4f23a019e
# Envio HyperIndex GraphQL endpoint (Hasura-compatible).
VITE_INDEXER_URL=http://localhost:8080/v1/graphql
# Optional explicit WebSocket endpoint; defaults to VITE_INDEXER_URL with http→ws.
# VITE_INDEXER_WS_URL=
# Oracle backend base URL (NestJS, includes /v1).
VITE_API_BASE=http://localhost:4000/v1
# Privy app id (auth + embedded wallet).
VITE_PRIVY_APP_ID=

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
