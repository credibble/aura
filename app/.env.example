# Aura app configuration — copy to .env and fill in.
# Contract addresses come from smart-contracts/deployments/deployments.json.
VITE_MARKET_MAKER_ADDRESS=
VITE_ORDER_BOOK_ADDRESS=
VITE_HANDLE_FACTORY_ADDRESS=
VITE_POOL_ADDRESS=
VITE_AURA_TOKEN_ADDRESS=
VITE_USDC_ADDRESS=
VITE_REVENUE_SHARING_ADDRESS=
# GraphQL endpoint for the aura subgraph.
VITE_SUBGRAPH_URL=http://localhost:8000/subgraphs/name/aura/aura
# Oracle backend base URL (NestJS, includes /v1).
VITE_API_BASE=http://localhost:4000/v1
# Privy app id (auth + embedded wallet).
VITE_PRIVY_APP_ID=

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
