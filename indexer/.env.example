# Copy to .env and fill in. Never commit .env.
#
# ENVIO_API_TOKEN — an Envio project token (https://envio.dev/app/api-tokens).
#   It unlocks HyperSync, the fast historical source for Monad testnet.
# ENVIO_RPC_URL — a JSON-RPC endpoint for chain 10143. The handlers' contract
#   reads (metadata, priceOf, pool/stake state) go through it, so it must serve
#   historical state. HyperRPC does: https://10143.rpc.hypersync.xyz/<token>.
ENVIO_API_TOKEN=
ENVIO_RPC_URL=
