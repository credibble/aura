# Aura oracle environment
NODE_ENV=development
PORT=4000

# Postgres (see docker-compose.yml) — the only connection store (no Redis)
DATABASE_URL=postgresql://aura:aura@localhost:5432/aura
# Passphrase for AES-256-GCM encryption of connection credentials at rest
CONNECTION_ENCRYPTION_KEY=

# Redis (see docker-compose.yml)
REDIS_URL=redis://localhost:6379

# On-chain resolution (filled in M5+)
ORACLE_PRIVATE_KEY=
ORACLE_ADDRESS=
CHAIN_ID=10143
ORACLE_ADAPTER_ADDRESS=
RPC_URL=https://testnet-rpc.monad.xyz

# Handle creation (POST /v1/handles) — HANDLE_OWNER_PRIVATE_KEY must be the
# HandleFactory OWNER key (createHandle is onlyOwner); endpoint answers 503
# until both are set.
HANDLE_OWNER_PRIVATE_KEY=
HANDLE_FACTORY_ADDRESS=

# AI — Kimi chat via Moonshot (chat completions)
KIMI_API_KEY=sk-...
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.5

# DEBUG_MODE — when true the oracle NEVER calls the AI provider. Every AI path
# (aura scoring, structured/feed completions, web search) short-circuits before
# any request and returns a random/sample response instead: no HTTP call, no
# token usage, no organisation slot/lock. Aura ticks sample a random signed
# percent inside the engine's ±5–20 band, so the engine still produces valid,
# moving ticks. Local/dev only; default false keeps production identical.
# Read at request time, so flipping it requires an oracle rebuild + restart.
DEBUG_MODE=false

# Kimi web search (standalone Web Search API - aura AI live context)
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
WEB_SEARCH_LIMIT=5

# Cloudinary - user post media uploads (auto-compressed)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=aura-posts

# Auth (wallet JWT) - dev default: dev-secret-change-me
AUTH_JWT_SECRET=

# Supabase - OAuth facilitation for social connections (connections callback
# exchanges the code with the secret key; unset = connect flows return 503)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Secret behind the social-OAuth PKCE verifier (HMAC). Optional - falls back to
# AUTH_JWT_SECRET / CONNECTION_ENCRYPTION_KEY. Must be stable across restarts.
OAUTH_PKCE_SECRET=

# Public app origin - the OAuth callback redirects the browser back here when
# the flow carries no return URL (dev default http://localhost:5173).
APP_URL=

# ── Job cadences ──────────────────────────────────────────────────────────────
# Aura AI per-handle scoring gate. A window shorter than this can open and close
# between two observations and be voided — keep handle windowMinutes above it.
AURA_AI_MIN_INTERVAL_MS=600000
# Aura level model - bounded, mean-reverting index. The level is
# baseline + deviation; the deviation band is +/- AURA_DEVIATION_MAX (1e2),
# reverted by AURA_REVERSION each tick, while the baseline is a slow EMA
# (AURA_BASELINE_ETA) pulled to its per-handle center (AURA_BASELINE_ANCHOR).
# Defaults give a ~45-min deviation half-life and a ~17h baseline.
AURA_DEVIATION_MAX=2500
AURA_REVERSION=0.2
AURA_BASELINE_ETA=0.01
AURA_BASELINE_ANCHOR=0.02
# Window scheduler sweep: how often graduated handles are checked to open/settle
# their current slot. Keep it far below windowMinutes.
WINDOW_EVERY_MS=180000
# Feed sweep: how often the AI drafts a digest per handle. 20m spaces the
# expensive per-handle AI calls out further (and cuts spend vs. the old 10m).
FEED_EVERY_MS=1200000

# ── Browser origins allowed to call this API (comma-separated) ────────────────
# The container runs NODE_ENV=production, where an EMPTY list refuses every
# origin — the app's dev server must be listed explicitly.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Chain read/write ──────────────────────────────────────────────────────────
# The public Monad endpoint caps at ~15 req/s and limits eth_getLogs to 100
# blocks; the gateway throttles every RPC call under RPC_MAX_RPS so bursts queue
# instead of failing. Prefer ALCHEMY_RPC_URL (used first when set) for a stable
# session, and a wider log range when reindexing.
RPC_MAX_RPS=10
# ALCHEMY_RPC_URL=https://monad-testnet.g.alchemy.com/v2/<your-key>

# On-chain addresses (smart-contracts/deployments/deployments.json)
MARKET_MAKER_ADDRESS=
ORACLE_FACTORY_ADDRESS=
# Envio indexer the engines read handles/windows from (local HyperIndex by default)
INDEXER_URL=http://localhost:8080/v1/graphql

# ── The AI's answer contract ──────────────────────────────────────────────────
# The models available on this key are REASONING models: thinking tokens come out
# of max_tokens before any answer, so tight budgets return an empty string with
# finish_reason "length". These budgets are sized for that.
# 'kimi-k2.*' accepts only temperature 1.
KIMI_TEMPERATURE=1
KIMI_MAX_TOKENS_DELTA=8192
KIMI_MAX_TOKENS_JSON=8192
KIMI_MAX_TOKENS_TOOLS=8192
# Cushion between Kimi calls, in ms. The org allows ONE in-flight request AND
# rate-limits per minute, so sequenced calls still need spacing — this is what
# keeps the engine under the limit instead of retrying through 429s. Both the
# api and the worker process jobs, so keep it generous: 2 x (1 call per gap).
KIMI_MIN_GAP_MS=2500

# X (Twitter) app credentials - the api/ search adapter reads OTHER people's
# public posts with the APP bearer token (read-only). A secret must never be
# committed: leave these empty and set them in .env.
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_BEARER_TOKEN=
